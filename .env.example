# ── Site ──────────────────────────────────────────────
# Public URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep the prototype out of search engines until approved
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Content source ────────────────────────────────────
# mock (default): bilingual demo content in src/data/mock
# wordpress:      headless WordPress (see docs/WORDPRESS.md)
CMS_SOURCE=mock

# Optional: simulated latency (ms) in mock mode to demo loading states
MOCK_LATENCY_MS=0

# ── WordPress (server-side only — never prefix with NEXT_PUBLIC_) ──
WORDPRESS_API_URL=https://cms.example.al/wp-json
# Polylang: lang · WPML: wpml_language
WORDPRESS_LANG_PARAM=lang
WORDPRESS_REVALIDATE_SECONDS=300
# Only needed to read drafts/private content (Application Password)
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Shared secret for the /api/revalidate webhook called by WordPress
REVALIDATE_SECRET=change-me
